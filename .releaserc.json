{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "angular" }],
    ["@semantic-release/release-notes-generator", { "preset": "angular" }],
    "@semantic-release/changelog",
    "@semantic-release/github",
    ["@semantic-release/git", { "assets": ["CHANGELOG.md"] }]
  ]
}
