# Copy to .env and set unique local credentials. Use URL-safe database passwords.
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BROWSER_SECRET=
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:8080
SESSION_DAYS=30
# Local Python process configuration (use the password configured above):
DATABASE_URL=postgresql+asyncpg://learning_platform:YOUR_PASSWORD@127.0.0.1:5432/learning_platform
BACKEND_URL=http://127.0.0.1:8000
