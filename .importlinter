[importlinter]
root_packages =
    backend
include_external_packages = True

[importlinter:contract:services-no-transport]
name = Backend services do not depend on API transport
type = forbidden
source_modules =
    backend.services
forbidden_modules =
    backend.api

[importlinter:contract:repositories-no-services]
name = Repositories do not depend on services or API
type = forbidden
source_modules =
    backend.database.async_repositories
forbidden_modules =
    backend.services
    backend.api
