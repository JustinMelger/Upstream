# Production Docker Compose configuration.
# Copy beside docker-compose.yml as .env on the deployment server.
# Replace all REPLACE_* values before starting. Do not commit the resulting .env.

# Use an existing published image tag, identical for API and UI.
API_IMAGE=ghcr.io/justinmelger/upstream-api:REPLACE_RELEASE_TAG
UI_IMAGE=ghcr.io/justinmelger/upstream-ui:REPLACE_RELEASE_TAG

# Public browser address, without /api or a trailing slash.
# Your HTTPS reverse proxy must forward requests to the UI on port 8080.
ENVIRONMENT=production
PUBLIC_ORIGIN=https://REPLACE_YOUR_HOST

# Use a URL-safe password because Compose embeds it in DATABASE_URL.
# Generate each secret separately:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# For an existing database, retain its current password.
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD

# Initial administrator credentials; changing this does not reset an existing account.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD

# Keep this secret stable across restarts; at least 32 characters.
BROWSER_SECRET=REPLACE_RANDOM_BROWSER_SECRET
SESSION_DAYS=30

# DATABASE_URL and API_ROOT_PATH are supplied by Compose.
# BACKEND_URL is not needed for this Docker deployment.
